{
  "info": {
    "_postman_id": "b1a1c3e4-f8d9-4a7c-9b1d-2e3f4a5b6c7d",
    "name": "Internal Assessment APIs",
    "description": "Faculty Workspace Internal Assessment APIs.\n\nBase path: `/internalAssessment/my`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET My Courses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my"]
        },
        "description": "All Primary timetable userId ↔ subjectId mappings. Subjects without assessment-plan CONTINUOUS_ASSESSMENT mapping are included with isContinuousAssessmentMapped=false, assessmentPlanComponent=null, fetchedWeightage=null. When mapped, fetchedWeightage comes only from CONTINUOUS_ASSESSMENT component."
      },
      "response": []
    },
    {
      "name": "GET My Dashboard SKU",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/sku",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "sku"]
        },
        "description": "User dashboard KPIs with assessment titles: totalSubjects, totalAssessments, remaining, readyToSubmit, remainingAssessments, readyToSubmitAssessments."
      },
      "response": []
    },
    {
      "name": "POST Create Assessment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subjectId\": 1,\n  \"classSectionTermId\": 1,\n  \"type\": \"Assignment\",\n  \"title\": \"Assignment 1 - Introduction to Fluid Properties\",\n  \"maximumMarks\": 30,\n  \"issueDate\": \"2026-09-01\",\n  \"dueDate\": \"2026-09-08\",\n  \"documentUrl\": \"https://example.com/Assignment_3_Questions.pdf\",\n  \"mode\": \"online\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/internalAssessment/my",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my"]
        },
        "description": "Creates a new internal assessment (Assignment / Quiz / Class Test)."
      },
      "response": []
    },
    {
      "name": "GET List Assessments By Subject",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/list?subjectId={{subjectId}}&classSectionTermId={{classSectionTermId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "list"],
          "query": [
            {
              "key": "subjectId",
              "value": "{{subjectId}}"
            },
            {
              "key": "classSectionTermId",
              "value": "{{classSectionTermId}}"
            }
          ]
        },
        "description": "Lists all internal assessments for a subject + classSectionTerm."
      },
      "response": []
    },
    {
      "name": "GET Students By Class Section Term",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/students?classSectionTermId={{classSectionTermId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "students"],
          "query": [
            {
              "key": "classSectionTermId",
              "value": "{{classSectionTermId}}"
            }
          ]
        },
        "description": "Fetches students by classSectionTermId, scoped to that term's class-section sessionId (studentModel only)."
      },
      "response": []
    },
    {
      "name": "GET Assessment Status Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/summary?subjectId={{subjectId}}&classSectionTermId={{classSectionTermId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "summary"],
          "query": [
            {
              "key": "subjectId",
              "value": "{{subjectId}}"
            },
            {
              "key": "classSectionTermId",
              "value": "{{classSectionTermId}}"
            }
          ]
        },
        "description": "Returns total / completed / open / upcoming counts plus assessments list with title and status."
      },
      "response": []
    },
    {
      "name": "GET Single Assessment",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/single?internalAssessmentId={{internalAssessmentId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "single"],
          "query": [
            {
              "key": "internalAssessmentId",
              "value": "{{internalAssessmentId}}"
            }
          ]
        },
        "description": "Fetches one internal assessment with subject/course/session details and marking progress counts (no studentEvaluations)."
      },
      "response": []
    },
    {
      "name": "PATCH Update Assessment",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"Assignment\",\n  \"title\": \"Assignment 1 - Introduction to Fluid Properties\",\n  \"maximumMarks\": 30,\n  \"issueDate\": \"2026-09-01\",\n  \"dueDate\": \"2026-09-08\",\n  \"documentUrl\": \"https://example.com/Assignment_3_Questions.pdf\",\n  \"mode\": \"online\",\n  \"weightagePercentage\": 10,\n  \"normalizedMaxMarks\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/internalAssessment/my?internalAssessmentId={{internalAssessmentId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my"],
          "query": [
            {
              "key": "internalAssessmentId",
              "value": "{{internalAssessmentId}}"
            }
          ]
        },
        "description": "Updates assessment fields / weightage. All body fields are optional."
      },
      "response": []
    },
    {
      "name": "GET Marks Table",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/marks/table?subjectId={{subjectId}}&classSectionTermId={{classSectionTermId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "marks", "table"],
          "query": [
            {
              "key": "subjectId",
              "value": "{{subjectId}}"
            },
            {
              "key": "classSectionTermId",
              "value": "{{classSectionTermId}}"
            }
          ]
        },
        "description": "Marks matrix for Faculty Workspace.\n\n- assessments: column headers\n- students[].marks: row cells aligned to assessments\n- studentIds / internalAssessmentIds / matrix: 2D array where matrix[studentIndex][assessmentIndex] = obtainedMarks"
      },
      "response": []
    },
    {
      "name": "GET Marks Cell",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/marks/cell?studentId={{studentId}}&internalAssessmentId={{internalAssessmentId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "marks", "cell"],
          "query": [
            {
              "key": "studentId",
              "value": "{{studentId}}"
            },
            {
              "key": "internalAssessmentId",
              "value": "{{internalAssessmentId}}"
            }
          ]
        },
        "description": "Single student × assessment cell for the marks sidebar (student, obtainedMarks, documentUrl, assessment max marks)."
      },
      "response": []
    },
    {
      "name": "GET Student Marks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/marks?internalAssessmentId={{internalAssessmentId}}&studentId={{studentId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "marks"],
          "query": [
            {
              "key": "internalAssessmentId",
              "value": "{{internalAssessmentId}}"
            },
            {
              "key": "studentId",
              "value": "{{studentId}}",
              "description": "Optional. When set, returns only that student's evaluation.",
              "disabled": true
            }
          ]
        },
        "description": "Fetches student evaluations for an assessment. Pass optional studentId to return only one student."
      },
      "response": []
    },
    {
      "name": "PUT Upsert Student Marks",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"marks\": [\n    {\n      \"studentId\": 1,\n      \"obtainedMarks\": 25\n    },\n    {\n      \"studentId\": 2,\n      \"obtainedMarks\": null\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/internalAssessment/my/marks?internalAssessmentId={{internalAssessmentId}}",
          "host": ["{{base_url}}"],
          "path": ["internalAssessment", "my", "marks"],
          "query": [
            {
              "key": "internalAssessmentId",
              "value": "{{internalAssessmentId}}"
            }
          ]
        },
        "description": "Creates or updates student marks for an assessment. Use null obtainedMarks for absent / not entered."
      },
      "response": []
    }
