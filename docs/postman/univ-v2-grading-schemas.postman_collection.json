{
  "info": {
    "_postman_id": "univ-v2-academic-regulation-and-grading-schemas-collection",
    "name": "Grading Schemas & Academic Regulation Module",
    "description": "Complete Postman collection for Academic Regulation (batchId refactor, Many-to-Many mappings), Batch Regulation verification, Term Marks Evaluation, and Linked Grading Schemas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Academic Regulation (/academicRegulation)",
      "item": [
        {
          "name": "1.1 Create Academic Regulation (with batchMappings array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.academicRegulationId) {",
                  "    pm.collectionVariables.set('academicRegulationId', res.data.academicRegulationId);",
                  "    console.log('Saved academicRegulationId:', res.data.academicRegulationId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regulationCode\": \"REG-2026-CS-01\",\n  \"regulationName\": \"Computer Science Academic Regulation 2026\",\n  \"description\": \"Regulation for CS batch with continuous assessment and credit policy\",\n  \"academicYearRange\": \"2026-2030\",\n  \"applicableBatch\": \"2026\",\n  \"effectiveFrom\": \"2026-08-01\",\n  \"effectiveUntil\": \"2030-07-31\",\n  \"gradingSchemeId\": 1,\n  \"evaluationPattern\": \"INTERNAL_EXTERNAL\",\n  \"internalWeightage\": 40.00,\n  \"externalWeightage\": 60.00,\n  \"maximumInternalMarks\": 40,\n  \"maximumExternalMarks\": 60,\n  \"isInternalAssessmentMandatory\": true,\n  \"isExternalAssessmentMandatory\": true,\n  \"minimumAttendance\": 75.00,\n  \"minimumOverallMarks\": 40,\n  \"minimumOverallPercentage\": 40.00,\n  \"minimumInternalMarks\": 16,\n  \"minimumExternalMarks\": 24,\n  \"mandatoryComponents\": [\"THEORY\", \"PRACTICAL\"],\n  \"calculateSGPA\": true,\n  \"calculateCGPA\": true,\n  \"calculatePercentage\": false,\n  \"generateClass\": true,\n  \"generateRank\": false,\n  \"totalCredits\": 160,\n  \"coreCredits\": 120,\n  \"electiveCredits\": 20,\n  \"openElectiveCredits\": 10,\n  \"internshipCredits\": 4,\n  \"projectCredits\": 6,\n  \"isAtktEnabled\": true,\n  \"maximumAtktSubjects\": 3,\n  \"isCarryForwardEnabled\": true,\n  \"maximumCarryForwardSubjects\": 3,\n  \"promotionMethod\": \"SEMESTER_WISE\",\n  \"isImprovementAllowed\": true,\n  \"maximumImprovementAttempts\": 2,\n  \"improvementMarksConsidered\": \"HIGHEST\",\n  \"isBacklogAllowed\": true,\n  \"maximumBacklogAttempts\": 3,\n  \"isSupplementaryAllowed\": true,\n  \"backlogValidityYears\": 5,\n  \"totalCreditsRequired\": 160,\n  \"minimumCgpa\": 5.00,\n  \"status\": \"DRAFT\",\n  \"isActive\": true,\n  \"batchMappings\": [\n    {{batchId}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/academicRegulation",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation"]
            },
            "description": "Creates a new Academic Regulation draft with associated batch mappings (no direct batchId or academicYearId on regulation table)."
          }
        },
        {
          "name": "1.2 Create Academic Regulation (with single batchId fallback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regulationCode\": \"REG-2026-IT-02\",\n  \"regulationName\": \"Information Technology Regulation 2026\",\n  \"description\": \"Regulation created with single batchId fallback in body\",\n  \"academicYearRange\": \"2026-2030\",\n  \"applicableBatch\": \"2026\",\n  \"batchId\": {{batchId}},\n  \"status\": \"DRAFT\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/academicRegulation",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation"]
            },
            "description": "Tests backward-compatibility where caller passes a single batchId in the body; the service automatically routes it into the mapping table."
          }
        },
        {
          "name": "1.3 Get List of Academic Regulations (Pagination & Search)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation?search=2026&status=DRAFT&page=1&limit=10",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation"],
              "query": [
                {
                  "key": "search",
                  "value": "2026",
                  "description": "Search by regulationName or regulationCode"
                },
                {
                  "key": "status",
                  "value": "DRAFT",
                  "description": "DRAFT | PUBLISHED | ARCHIVED"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lists regulations with pagination. Verifies nested courseMappings include the joined batch object."
          }
        },
        {
          "name": "1.4 Filter Academic Regulations by batchId",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation?batchId={{batchId}}",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation"],
              "query": [
                {
                  "key": "batchId",
                  "value": "{{batchId}}",
                  "description": "Filter regulations mapped to this batchId"
                }
              ]
            },
            "description": "Filters regulations connected to the specified batchId via academic_regulation_course_mapping."
          }
        },
        {
          "name": "1.5 Get Academic Regulation by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation/{{academicRegulationId}}",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation", "{{academicRegulationId}}"]
            },
            "description": "Retrieves regulation details along with its nested courseMappings (batches) and classifications."
          }
        },
        {
          "name": "1.6 Update Academic Regulation (Reconcile batchMappings)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regulationName\": \"Computer Science Academic Regulation 2026 (Updated)\",\n  \"description\": \"Updated description and reconciled batch mappings\",\n  \"batchMappings\": [\n    {{batchId}}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/academicRegulation/{{academicRegulationId}}",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation", "{{academicRegulationId}}"]
            },
            "description": "Updates regulation fields and reconciles mapped batches. Increments version by +0.1."
          }
        },
        {
          "name": "1.7 Toggle Active / Delete Academic Regulation",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation/{{academicRegulationId}}",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation", "{{academicRegulationId}}"]
            },
            "description": "Soft toggles isActive state of the academic regulation."
          }
        }
      ]
    },
    {
      "name": "2. Batch Regulation Course Mapping (/academicRegulation/courseRegulationMapping)",
      "item": [
        {
          "name": "2.1 Create Batch Regulation Mapping",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data && res.data.academicRegulationCourseMappingId) {",
                  "    pm.collectionVariables.set('academicRegulationCourseMappingId', res.data.academicRegulationCourseMappingId);",
                  "    console.log('Saved academicRegulationCourseMappingId:', res.data.academicRegulationCourseMappingId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"academicRegulationId\": {{academicRegulationId}},\n  \"batchId\": {{batchId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/academicRegulation/courseRegulationMapping",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation", "courseRegulationMapping"]
            },
            "description": "Maps a batchId to an academicRegulationId. Allows multiple regulations per batch and multiple batches per regulation (N:M). Prevents duplicate identical pairs."
          }
        },
        {
          "name": "2.2 Get Mappings by Academic Regulation ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation/courseRegulationMapping/{{academicRegulationId}}",
              "host": ["{{baseurl}}"],
              "path": [
                "academicRegulation",
                "courseRegulationMapping",
                "{{academicRegulationId}}"
              ]
            },
            "description": "Fetches all batch mappings assigned to a specific regulation."
          }
        },
        {
          "name": "2.3 Get Mappings by batchId Query",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation/courseRegulationMapping?batchId={{batchId}}",
              "host": ["{{baseurl}}"],
              "path": ["academicRegulation", "courseRegulationMapping"],
              "query": [
                {
                  "key": "batchId",
                  "value": "{{batchId}}"
                }
              ]
            },
            "description": "Fetches all regulations assigned to a specific batchId."
          }
        },
        {
          "name": "2.4 Delete Batch Regulation Mapping",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/academicRegulation/courseRegulationMapping/{{academicRegulationCourseMappingId}}",
              "host": ["{{baseurl}}"],
              "path": [
                "academicRegulation",
                "courseRegulationMapping",
                "{{academicRegulationCourseMappingId}}"
              ]
            },
            "description": "Deletes a batch-to-regulation mapping row by academicRegulationCourseMappingId."
          }
        }
      ]
    },
    {
      "name": "3. Consumer Verification (Batches & Student Marks)",
      "item": [
        {
          "name": "3.1 Get Batch Full Details (Verify regulationBatchMappings)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/session/batches/{{batchId}}/details",
              "host": ["{{baseurl}}"],
              "path": ["session", "batches", "{{batchId}}", "details"]
            },
            "description": "Fetches batch full details. Verifies that regulationBatchMappings includes the linked regulation without using obsolete session-course joins."
          }
        },
        {
          "name": "3.2 Get Term Student Marks (Verify Regulation Rules Evaluation)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/previousAcademic/terms/{{curriculumBatchTermMappingId}}/students/marks?sessionId={{sessionId}}",
              "host": ["{{baseurl}}"],
              "path": [
                "previousAcademic",
                "terms",
                "{{curriculumBatchTermMappingId}}",
                "students",
                "marks"
              ],
              "query": [
                {
                  "key": "sessionId",
                  "value": "{{sessionId}}",
                  "description": "Academic Session ID"
                }
              ]
            },
            "description": "Evaluates student term marks and passing status against the academic regulation linked to the batch via batchId."
          }
        }
      ]
    },
    {
      "name": "4. Linked Grading Schemas Helper (/gradingSchemas)",
      "item": [
        {
          "name": "4.1 Get All Grading Schemas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/gradingSchemas?page=1&limit=10",
              "host": ["{{baseurl}}"],
              "path": ["gradingSchemas"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Lists grading schemes that can be linked to Academic Regulations via gradingSchemeId."
          }
        },
        {
          "name": "4.2 Get Grading Schema by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/gradingSchemas/{{gradingSchemeId}}",
              "host": ["{{baseurl}}"],
              "path": ["gradingSchemas", "{{gradingSchemeId}}"]
            },
            "description": "Fetches details and grade scales for a specific grading scheme."
          }
        }
      ]
    }
  ],
