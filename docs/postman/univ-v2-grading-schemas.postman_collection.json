{
	"info": {
		"_postman_id": "grading-schemas-api-collection-v2",
		"name": "Grading Schemas Module",
		"description": "Complete Postman collection for Grading Schemas and Grade Scales APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Grading Schemas",
			"item": [
				{
					"name": "1.1 Create Grading Schema",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"gradingName\": \"Standard 10-Point Grading Scale\",\n  \"gradingCode\": \"G10_SCALE\",\n  \"gradingMethod\": \"ABSOLUTE\",\n  \"maximumMarks\": 100,\n  \"minimumPassingMarks\": 40,\n  \"description\": \"Standard absolute grading scheme for undergraduate programs.\",\n  \"status\": \"DRAFT\",\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseurl}}/gradingSchemas",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var res = pm.response.json();",
									"if (res.success && res.data && res.data.gradingId) {",
									"    pm.collectionVariables.set('gradingSchemaId', res.data.gradingId);",
									"    console.log('Saved gradingSchemaId:', res.data.gradingId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "1.2 Get All Grading Schemas",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseurl}}/gradingSchemas?search=&status=&gradingMethod=&page=1&limit=10",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas"
							],
							"query": [
								{
									"key": "search",
									"value": ""
								},
								{
									"key": "status",
									"value": ""
								},
								{
									"key": "gradingMethod",
									"value": ""
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "1.3 Get Grading Schema By ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/{{gradingSchemaId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"{{gradingSchemaId}}"
							]
						}
					}
				},
				{
					"name": "1.4 Update Grading Schema",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"gradingName\": \"Updated 10-Point Scale\",\n  \"gradingCode\": \"G10_SCALE_V2\",\n  \"gradingMethod\": \"ABSOLUTE\",\n  \"maximumMarks\": 100,\n  \"minimumPassingMarks\": 35,\n  \"description\": \"Updated grading scheme details\",\n  \"status\": \"DRAFT\"\n}"
						},
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/{{gradingSchemaId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"{{gradingSchemaId}}"
							]
						}
					}
				},
				{
					"name": "1.5 Delete Grading Schema",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/{{gradingSchemaId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"{{gradingSchemaId}}"
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Grade Items",
			"item": [
				{
					"name": "2.1 Add Grade to Schema",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"grade\": \"B+\",\n  \"minPercentage\": 70.0,\n  \"maxPercentage\": 79.99,\n  \"gradePoint\": 8.0,\n  \"resultLabel\": \"Very Good\",\n  \"remarks\": \"Above average\",\n  \"sortOrder\": 4,\n  \"isPass\": true,\n  \"isActive\": true\n}"
						},
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/grades/{{gradingSchemaId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"grades",
								"{{gradingSchemaId}}"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var res = pm.response.json();",
									"if (res.success && res.data && res.data.gradingGradeId) {",
									"    pm.collectionVariables.set('gradingSchemaGradeId', res.data.gradingGradeId);",
									"    console.log('Saved gradingSchemaGradeId:', res.data.gradingGradeId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "2.2 Get Schema Grades",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/grades/{{gradingSchemaId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"grades",
								"{{gradingSchemaId}}"
							]
						}
					}
				},
				{
					"name": "2.3 Get Grade By ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/grades/{{gradingSchemaGradeId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"grades",
								"{{gradingSchemaGradeId}}"
							]
						}
					}
				},
				{
					"name": "2.4 Update Grade",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"grade\": \"B+\",\n  \"minPercentage\": 65.0,\n  \"maxPercentage\": 74.99,\n  \"gradePoint\": 7.5,\n  \"resultLabel\": \"Good\"\n}"
						},
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/grades/{{gradingSchemaGradeId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"grades",
								"{{gradingSchemaGradeId}}"
							]
						}
					}
				},
				{
					"name": "2.5 Delete Grade",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseurl}}/gradingSchemas/grades/{{gradingSchemaGradeId}}",
							"host": [
								"{{baseurl}}"
							],
							"path": [
								"gradingSchemas",
								"grades",
								"{{gradingSchemaGradeId}}"
							]
						}
					}
				}
			]
		},
		{
			"name": "3. Status Management",
			"item": [
				{
					"name": "3.1 Publish Grading Schema",
					"request": {
						"method": "POST",
						"header": [
