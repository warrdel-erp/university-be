          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const departmentId = pm.collectionVariables.get('departmentId');",
                  "if (!departmentId) throw new Error('departmentId is not set. Create a department first.');",
                  "pm.request.body.update(JSON.stringify({",
                  "  departmentId: Number(departmentId),",
                  "  departmentName: 'School of Engineering',",
                  "  departmentCode: 'SOE',",
                  "  alternateName: null,",
                  "  description: null,",
