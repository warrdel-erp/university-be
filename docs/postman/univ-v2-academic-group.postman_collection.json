            "url": {
              "raw": "{{baseurl}}/academicGroup/scope",
              "host": ["{{baseurl}}"],
              "path": ["academicGroup", "scope"]
            },
            "description": "**POST /academicGroup/scope**\n\n`program_specific` requires `courseId`, `sessionId`, `term`.\n\nSaves `academicGroupScopeId`."
          },
          "response": []
        },
