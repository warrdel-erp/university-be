    {
      "name": "1. scope",
      "description": "Step 1 — create / read / update / delete `academic_group_scope`.",
      "item": [
        {
          "name": "POST scope (activity context)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const res = pm.response.json();",
                  "  const row = res.data;",
                  "  if (row && row.academicGroupScopeId) {",
                  "    pm.collectionVariables.set('academicGroupScopeId', String(row.academicGroupScopeId));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupType\": \"teaching\",\n  \"title\": \"Dissertation\",\n  \"selectionScope\": \"program_specific\",\n  \"courseId\": {{courseId}},\n  \"sessionId\": {{sessionId}},\n  \"term\": {{term}},\n  \"academicContextType\": \"activity\",\n  \"activityName\": \"Design Thinking Workshop\"\n}",
              "options": { "raw": { "language": "json" } }
