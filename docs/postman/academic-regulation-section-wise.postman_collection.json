      "name": "Step 1: Basic Information (Create)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"regulationCode\": \"REG-2026-CS\",\n  \"regulationName\": \"Computer Science Regulation 2026\",\n  \"description\": \"Standard B.Tech CS Regulation\",\n  \"academicYearRange\": \"2024-2029\",\n  \"applicableBatch\": \"2026 Batch\",\n  \"effectiveFrom\": \"2026-08-01\",\n  \"effectiveUntil\": \"2030-07-31\",\n  \"gradingSchemeId\": 1,\n  \"status\": \"DRAFT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/academic-regulations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "academic-regulations"
          ]
        },
        "description": "Creates a new Academic Regulation draft. Only regulationCode and regulationName are strictly required to create the draft."
      }
    },
