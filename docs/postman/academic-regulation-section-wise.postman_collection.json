          "mode": "raw",
          "raw": "{\n  \"evaluationPattern\": \"SEMESTER\",\n  \"internalWeightage\": 40,\n  \"externalWeightage\": 60,\n  \"maximumInternalMarks\": 40,\n  \"maximumExternalMarks\": 60,\n  \"isInternalAssessmentMandatory\": true,\n  \"isExternalAssessmentMandatory\": true\n}",
