{
  "info": {
    "_postman_id": "evaluations-api-collection-v2",
    "name": "Evaluations Module (Simplified)",
    "description": "Simplified Postman collection focusing only on the core Answer Sheet evaluation workflow (Mapping, Assigning, and Grading).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin: Mapping & Assignment",
      "description": "Admin APIs to map answer sheets and assign evaluators.",
      "item": [
        {
          "name": "1.1 PATCH Map QR To Student",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qr\": \"{{evaluation_qr}}\",\n  \"studentId\": {{evaluation_studentId}},\n  \"examScheduleId\": {{evaluation_examScheduleId}}\n}"
            },
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/map",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "map"
              ]
            },
            "description": "PATCH /answerSheetQr/map"
          }
        },
        {
          "name": "1.2 GET Mapped Answer Sheets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/list?examinationSessionId=1&selections=%5B%7B%22courseSessionMappingId%22%3A34%2C%22terms%22%3A%5B1%2C2%2C4%5D%7D%5D&page=1&limit=20",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "list"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "1"
                },
                {
                  "key": "examScheduleId",
                  "value": "{{evaluation_examScheduleId}}"
                },
                {
                  "key": "selections",
                  "value": "%5B%7B%22courseSessionMappingId%22%3A34%2C%22terms%22%3A%5B1%2C2%2C4%5D%7D%5D",
                  "description": "JSON array: [{\"courseSessionMappingId\":34,\"terms\":[1,2,4]}]"
                },
                {
                  "key": "examDate",
                  "value": "2026-06-15",
                  "disabled": true
                },
                {
                  "key": "examinationSessionSlotId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "subjectId",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "unassigned",
                  "description": "unassigned | graded (markingStatus=submit; omit for all)",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "GET /answerSheetQr/list — optional status: unassigned (no evaluator) or graded (markingStatus=submit). Each item includes markingStatus (submit = checked). Assignment-wise rows: GET /answerSheetQr/assignmentslist."
          }
        },
        {
          "name": "1.2b GET Evaluation Assignments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/assignmentslist?examinationSessionId={{evaluation_examinationSessionId}}&page=1&limit=20",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "assignmentslist"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}"
                },
                {
                  "key": "examScheduleId",
                  "value": "{{evaluation_examScheduleId}}",
                  "disabled": true
                },
                {
                  "key": "selections",
                  "value": "{{evaluation_selections}}",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "GET /answerSheetQr/assignmentslist — one row per assignment. Nested examSchedules[] with subject name/code, exam dates, and SKU counts.\n\ngradedScripts / remainingScripts use markingStatus=submit as checked."
          }
        },
        {
          "name": "1.3 POST Assign Evaluator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToUserId\": {{evaluation_assignedToUserId}},\n  \"answerSheetQrIds\": [\n    {{evaluation_answerSheetQrId}}\n  ],\n  \"deadlineDate\": \"{{evaluation_deadline}}\"\n}"
            },
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/assign/evaluator",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "assign",
                "evaluator"
              ]
            },
            "description": "POST /answerSheetQr/assign/evaluator — bulk assign one user to many answer sheets."
          }
        },
        {
          "name": "1.4 GET Scripts By Evaluator",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/evaluator/{{evaluation_assignedToUserId}}?page=1&limit=20",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "evaluator",
                "{{evaluation_assignedToUserId}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "GET /answerSheetQr/evaluator/:assignedToUserId — admin view of scripts assigned to a specific evaluator. Requires ANSWER_SHEET_QRS.\n\nResponse data: { items: [...], teacher: { userId, userName, email } }"
          }
        },
        {
          "name": "1.5 GET Answer Sheet QR By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/{{evaluation_answerSheetQrId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "{{evaluation_answerSheetQrId}}"
              ]
            },
            "description": "GET /answerSheetQr/:id — admin detail view. Requires ANSWER_SHEET_QRS."
          }
        },
        {
          "name": "1.5b GET Approved Question Paper By Answer Sheet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/questionPaper?answerSheetQrId={{evaluation_answerSheetQrId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "questionPaper"
              ],
              "query": [
                {
                  "key": "answerSheetQrId",
                  "value": "{{evaluation_answerSheetQrId}}"
                }
              ]
            },
            "description": "GET /answerSheetQr/questionPaper?answerSheetQrId= — approved question paper (finalApproval=Approved) for the answer sheet's exam schedule. Requires ANSWER_SHEET_QRS."
          }
        },
        {
          "name": "1.6 PATCH Assign Obtained Marks (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"obtained_marks\": {{evaluation_obtainedMarks}}\n}"
            },
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/{{evaluation_answerSheetQrId}}/obtainedMarks",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "{{evaluation_answerSheetQrId}}",
                "obtainedMarks"
              ]
            },
            "description": "PATCH /answerSheetQr/:id/obtainedMarks — admin draft marks entry. Sets markingStatus to pending. Requires EVALUATION_EXECUTE."
          }
        },
        {
          "name": "1.7 POST Final Submit (bulk, admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {{evaluation_answerSheetQrId}}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/finalSubmit",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "finalSubmit"
              ]
            },
            "description": "POST /answerSheetQr/finalSubmit — admin bulk final submit. Sets markingStatus to submit; keeps existing obtained_marks unless provided.\n\nPayload: { \"items\": [1, 2, 3] } or { \"items\": [{ \"answerSheetQrId\": 1 }, { \"answerSheetQrId\": 2, \"obtained_marks\": 75 }] }\n\nRequires EVALUATION_EXECUTE."
          }
        },
        {
          "name": "1.8 GET Answer Sheet SKU Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/skuStats?examinationSessionId={{evaluation_examinationSessionId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "skuStats"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}"
                }
              ]
            },
            "description": "GET /answerSheetQr/skuStats?examinationSessionId= — session-level answer sheet SKU counts for mapped scripts.\n\nResponse format matches /my/skuStats — data.sku:\n- totalAssigned\n- graded\n- notChecked\n- overdue\n- dueToday"
          }
        }
      ]
    },
    {
      "name": "2. Evaluator: Self-Service (/my)",
      "description": "Endpoints for the assigned evaluator to view their scripts and submit marks.",
      "item": [
        {
          "name": "2.1 GET My SKU Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/skuStats",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "skuStats"
              ]
            },
            "description": "GET /answerSheetQr/my/skuStats — teacher dashboard SKU counts.\n\nChecked = markingStatus submit.\n\nResponse data.sku:\n- totalAssigned\n- graded (markingStatus=submit)\n- notChecked (markingStatus pending)\n- overdue (pending past deadline)\n- dueToday (pending due today)"
          }
        },
        {
          "name": "2.2 GET My Evaluation Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/summary",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "summary"
              ]
            },
            "description": "GET /answerSheetQr/my/summary — totalAssigned, evaluated (markingStatus=submit), pending (not submit)."
          }
        },
        {
          "name": "2.3 GET My Assigned Scripts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my?page=1&limit=20&examinationSessionId={{evaluation_examinationSessionId}}&examScheduleId={{evaluation_examScheduleId}}&status=saved",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}"
                },
                {
                  "key": "examScheduleId",
                  "value": "{{evaluation_examScheduleId}}"
                },
                {
                  "key": "status",
                  "value": "saved",
                  "description": "Optional. saved | submitted\n- submitted: markingStatus=submit (checked)\n- saved: markingStatus=pending AND obtainedMarks is not null (draft marks, including 0)"
                }
              ]
            },
            "description": "GET /answerSheetQr/my — optional examinationSessionId, examScheduleId, status (saved|submitted). Each item includes markingStatus, obtainedMarks, fileUploadId and s3File."
          }
        },
        {
          "name": "2.3b GET My Evaluation Examination Sessions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/evaluationExaminationSessions",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "evaluationExaminationSessions"
              ]
            },
            "description": "GET /answerSheetQr/my/evaluationExaminationSessions — reverse populate from assigned scripts via Sequelize joins.\n\nShape: examinationSession → examinationSessionTerms[] + examSchedules[] (subjectSchedule.courseInfo, totalAssigned/graded/remaining).\n\nexaminationSessionTerms only include terms that appear on the evaluator's assigned examSchedules (e.g. only term 1 when all schedules are term 1)."
          }
        },
        {
          "name": "2.4 GET My Single Script",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/single?id=2",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "single"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "2"
                }
              ]
            },
            "description": "GET /answerSheetQr/my/single?id=2 — single script without student details. Includes markingStatus (submit = checked)."
          }
        },
        {
          "name": "2.5 PATCH My Obtained Marks",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"obtained_marks\": {{evaluation_obtainedMarks}}\n}"
            },
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/{{evaluation_answerSheetQrId}}/obtainedMarks",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "{{evaluation_answerSheetQrId}}",
                "obtainedMarks"
              ]
            },
            "description": "PATCH /answerSheetQr/my/:id/obtainedMarks — draft save; sets markingStatus to pending."
          }
        },
        {
          "name": "2.5b GET My Approved Question Paper",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/questionPaper?answerSheetQrId={{evaluation_answerSheetQrId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "questionPaper"
              ],
              "query": [
                {
                  "key": "answerSheetQrId",
                  "value": "{{evaluation_answerSheetQrId}}"
                }
              ]
            },
            "description": "GET /answerSheetQr/my/questionPaper?answerSheetQrId= — approved question paper (finalApproval=Approved) for the answer sheet's exam schedule. Sheet must be assigned to the current evaluator."
          }
        },
        {
          "name": "2.6 POST My Final Submit (bulk)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {{evaluation_answerSheetQrId}}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseurl}}/answerSheetQr/my/finalSubmit",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "answerSheetQr",
                "my",
                "finalSubmit"
              ]
            },
            "description": "POST /answerSheetQr/my/finalSubmit — bulk final submit for sheets assigned to the current evaluator. Sets markingStatus to submit; keeps existing obtained_marks unless provided.\n\nPayload: { \"items\": [1, 2, 3] } or { \"items\": [{ \"answerSheetQrId\": 1 }, { \"answerSheetQrId\": 2, \"obtained_marks\": 75 }] }"
          }
        }
      ]
    },
    {
      "name": "3. Exam Result",
      "description": "Exam result readiness and published student results.\n\nfilterStatus:\n- Ready — all applicable sheets markingStatus=submit and no student_result yet\n- NotReady — not all sheets submitted\n- Published — student_result exists\n\nRoutes under /examResult",
      "item": [
        {
          "name": "3.0 GET Exam Result SKU",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/examResult/sku?examinationSessionId={{evaluation_examinationSessionId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "examResult",
                "sku"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}",
                  "description": "Required"
                }
              ]
            },
            "description": "GET /examResult/sku?examinationSessionId=\n\nQuery: examinationSessionId (required)\n\nReturns flat SKU counts: totalExams, totalStudents, totalAnswerSheets, checked, notChecked, ready, notReady"
          }
        },
        {
          "name": "3.1 GET Exam Result Students (list)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/examResult/students?examinationSessionId={{evaluation_examinationSessionId}}&selections={{evaluation_selections}}&filterStatus=Ready&page=1&limit=20",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "examResult",
                "students"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}",
                  "description": "Optional → latest when omitted"
                },
                {
                  "key": "selections",
                  "value": "{{evaluation_selections}}",
                  "description": "Optional JSON: [{\"courseSessionMappingId\":34,\"terms\":[1,2]}]"
                },
                {
                  "key": "filterStatus",
                  "value": "Ready",
                  "description": "Optional: Ready | NotReady | Published"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "Optional name / scholarNumber / enrollNumber",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "GET /examResult/students\n\nQuery:\n- examinationSessionId (optional)\n- selections (optional JSON)\n- filterStatus: Ready | NotReady | Published\n- search, page, limit\n\nItems include readinessStatus and exam counts."
          }
        },
        {
          "name": "3.2 GET Exam Result Student (detail)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/examResult/students/{{evaluation_studentId}}?examinationSessionId={{evaluation_examinationSessionId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "examResult",
                "students",
                "{{evaluation_studentId}}"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}",
                  "description": "Optional → latest when omitted"
                },
                {
                  "key": "selections",
                  "value": "{{evaluation_selections}}",
                  "description": "Optional JSON course/session/term filter",
                  "disabled": true
                }
              ]
            },
            "description": "GET /examResult/students/:studentId\n\nReturns student (with course/session/admissionDate), readiness, and per-exam sheet status."
          }
        },
        {
          "name": "3.3 POST Create Examination Session Result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examinationSessionId\": {{evaluation_examinationSessionId}},\n  \"studentIds\": [{{evaluation_studentId}}]\n}"
            },
            "url": {
              "raw": "{{baseurl}}/examResult/examinationSessionResult",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "examResult",
                "examinationSessionResult"
              ]
            },
            "description": "POST /examResult/examinationSessionResult\n\nBody:\n{\n  \"examinationSessionId\": 1,\n  \"studentIds\": [2, 3]\n}\n\nCreates/publishes student_result for ready students. Message: result is saved and submitted"
          }
        },
        {
          "name": "3.4 GET Published Student Result",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseurl}}/examResult/result?examinationSessionId={{evaluation_examinationSessionId}}&studentId={{evaluation_studentId}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "examResult",
                "result"
              ],
              "query": [
                {
                  "key": "examinationSessionId",
                  "value": "{{evaluation_examinationSessionId}}",
                  "description": "Required"
                },
                {
                  "key": "studentId",
                  "value": "{{evaluation_studentId}}",
                  "description": "Required"
                }
              ]
            },
            "description": "GET /examResult/result?examinationSessionId=&studentId=\n\nFetches one saved/published student_result with examinationSession, student, studentResult totals, readiness, and exams.\n\n404 if result not found."
          }
