          "query": [
            {
              "key": "feePlanItemId",
              "value": "{{feePlanItemId}}"
            }
          ]
        },
        "description": "DELETE /feePlanItem?feePlanItemId=\n\nDeletes a draft fee plan item and its associated sub-items."
      },
      "response": []
    },
