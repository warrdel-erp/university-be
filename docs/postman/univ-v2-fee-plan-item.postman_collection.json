      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feePlanItemId\": {{feePlanItemId}},\n  \"name\": \"Updated Semester 1 Tuition Fee\",\n  \"createDate\": \"2026-08-15\",\n  \"year\": {{year}},\n  \"feePlanSubItems\": [\n    {\n      \"feeTypeCatalogId\": {{feeTypeCatalogId}},\n      \"amount\": \"55000.00\",\n      \"isMainSubItem\": true\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseurl}}/feePlanItem",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem"
          ]
        },
        "description": "PATCH /feePlanItem\n\nUpdates an un-published fee plan item's details (name, createDate, year) and synchronizes sub-item components."
      },
      "response": []
    },
