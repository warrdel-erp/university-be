    {
      "name": "6. Publish",
      "item": [
        {
          "name": "6.1 Publish fee plan year",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": {{batchId}},\n  \"year\": {{year}}\n}"
            },
            "url": {
              "raw": "{{baseurl}}/feePlanItem/publish",
              "host": ["{{baseurl}}"],
              "path": ["feePlanItem", "publish"]
            },
            "description": "PATCH /feePlanItem/publish\n\nAPI Name: Publish Fee Plan Year\nMethod: PATCH\nEndpoint: /feePlanItem/publish\nAuth: Bearer token\nPermission: FEES_PLAN_PUBLISH\nHeaders: Authorization, Content-Type, Accept\n\nBody (required):\n- batchId (Integer)\n- year (Integer, 1…courseDuration)\n\nRules:\n- All fee_plan_item rows for batch+year must have ≥1 sub-item\n- Sets publish_status=published on those items\n- Appends fee_plan_publish_history row\n- Locks items from edit/delete until unpublished\n\nSuccess data: batchId, year, feePlanPublishHistoryId, publishStatus, publishedAt, publishedBy\n\nErrors: 400 (already published / missing components / year out of range), 401, 403, 404, 500\n\nSee docs/postman/FEE_PLAN_ITEM.md"

          }
        },
        {
          "name": "6.2 Unpublish fee plan year",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"batchId\": {{batchId}},\n  \"year\": {{year}}\n}"
            },
            "url": {
              "raw": "{{baseurl}}/feePlanItem/unpublish",
              "host": ["{{baseurl}}"],
              "path": ["feePlanItem", "unpublish"]
            },
            "description": "PATCH /feePlanItem/unpublish\n\nAPI Name: Unpublish Fee Plan Year\nMethod: PATCH\nEndpoint: /feePlanItem/unpublish\nAuth: Bearer token\nPermission: FEES_PLAN_PUBLISH\n\nBody: { batchId, year }\n\nBlocked if any student_fee_invoice (status=generated) exists for those items.\nSets publish_status=draft and appends history action=unpublish.\n\nErrors: 400 (not published / invoices exist), 401, 403, 404, 500\n\nSee docs/postman/FEE_PLAN_ITEM.md"

          }
        },
        {
          "name": "6.3 Get publish history",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseurl}}/feePlanItem/publishHistory?batchId={{batchId}}&year={{year}}",
              "host": ["{{baseurl}}"],
              "path": ["feePlanItem", "publishHistory"],
              "query": [
                { "key": "batchId", "value": "{{batchId}}", "description": "Required" },
                { "key": "year", "value": "{{year}}", "description": "Optional year filter" }
              ]
            },
            "description": "GET /feePlanItem/publishHistory?batchId=&year=\n\nAPI Name: Get Fee Plan Publish History\nMethod: GET\nAuth: Bearer token\nPermission: FEES_PLAN\n\nQuery:\n- batchId (required Integer)\n- year (optional Integer)\n\nResponse data: { batchId, year, history[] }\nhistory[]: feePlanPublishHistoryId, batchId, year, action (publish|unpublish), publishedAt, publishedBy\n\nSee docs/postman/FEE_PLAN_ITEM.md"

          }
        },
        {
          "name": "6.4 Get publish history single",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseurl}}/feePlanItem/publishHistory/single?feePlanPublishHistoryId={{feePlanPublishHistoryId}}",
              "host": ["{{baseurl}}"],
              "path": ["feePlanItem", "publishHistory", "single"],
              "query": [
                { "key": "feePlanPublishHistoryId", "value": "{{feePlanPublishHistoryId}}", "description": "History row id from publish response" }
              ]
            },
            "description": "GET /feePlanItem/publishHistory/single?feePlanPublishHistoryId=\n\nAPI Name: Get Fee Plan Publish History Single\nMethod: GET\nAuth: Bearer token\nPermission: FEES_PLAN\n\nQuery: feePlanPublishHistoryId (required Integer)\n\nResponse: feePlanPublishHistoryId, batchId, year, action, publishedAt, publishedBy\n\nErrors: 400, 401, 403, 404, 500\n\nSee docs/postman/FEE_PLAN_ITEM.md"

          }
        }
      ]
    }
  ]
