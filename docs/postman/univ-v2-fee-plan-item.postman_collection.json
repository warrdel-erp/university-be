        },
        "url": {
          "raw": "{{baseurl}}/feePlanItem/publish",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "publish"
          ]
        },
        "description": "PATCH /feePlanItem/publish\n\nPublishes all fee plan items for a batch and year, recording published_at, published_by and an entry in fee_plan_publish_history."
      },
      "response": []
    },
    {
