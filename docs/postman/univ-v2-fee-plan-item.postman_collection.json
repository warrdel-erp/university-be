  "item": [
    {
      "name": "1. Get Fee Plan Batches (List & Status)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/batches?courseId={{courseId}}&sessionId={{sessionId}}&search=&status=Draft",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "batches"
          ],
          "query": [
            {
              "key": "courseId",
              "value": "{{courseId}}",
              "description": "Filter by Course ID"
            },
            {
              "key": "sessionId",
              "value": "{{sessionId}}",
              "description": "Filter by Session ID"
            },
            {
              "key": "search",
              "value": "",
              "description": "Search by Course Name, Code, Session, or Batch Year"
            },
            {
              "key": "status",
              "value": "Draft",
              "description": "Published | In Review | Draft | Setup Required"
            }
          ]
        },
        "description": "GET /feePlanItem/batches\n\nReturns all batches grouped with Course, Session, Academic Year context and overall fee plan configuration status."
      },
      "response": []
    },
    {
      "name": "2. Get Batch Fee Plan Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/batches/overview?batchId={{batchId}}",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "batches",
            "overview"
          ],
          "query": [
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Required Batch ID"
            }
          ]
        },
        "description": "GET /feePlanItem/batches/overview?batchId=\n\nReturns batch-level fee plan configuration overview across all course duration years, including summaries, student counts, and status per year."
      },
      "response": []
    },
    {
      "name": "3. Get Batch Year Fee Receipts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/batches/year?batchId={{batchId}}&year={{year}}",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "batches",
            "year"
          ],
          "query": [
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Required Batch ID"
            },
            {
              "key": "year",
              "value": "{{year}}",
              "description": "Required Year (e.g. 1, 2, 3)"
            }
          ]
        },
        "description": "GET /feePlanItem/batches/year?batchId=&year=\n\nReturns detailed fee receipts configuration for a specific batch and year, including feePlanSubItems lines and catalog details."
      },
      "response": []
    },
    {
      "name": "4. Get Batch Billing Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/batches/billing?batchId={{batchId}}&year={{year}}",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "batches",
            "billing"
          ],
          "query": [
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Required Batch ID"
            },
            {
              "key": "year",
              "value": "{{year}}",
              "description": "Required Year (e.g. 1, 2, 3)"
            }
          ]
        },
        "description": "GET /feePlanItem/batches/billing?batchId=&year=\n\nReturns billing status and billing forecast per receipt for a batch and year, showing raised invoice counts, amounts per student, and expected batch totals."
      },
      "response": []
    },
    {
      "name": "5. Get Billing Runs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/billingRuns?courseId={{courseId}}&sessionId={{sessionId}}&batchId={{batchId}}&year={{year}}&search=",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "billingRuns"
          ],
          "query": [
            {
              "key": "courseId",
              "value": "{{courseId}}",
              "description": "Optional Course ID filter"
            },
            {
              "key": "sessionId",
              "value": "{{sessionId}}",
              "description": "Optional Session ID filter"
            },
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Optional Batch ID filter"
            },
            {
              "key": "year",
              "value": "{{year}}",
              "description": "Optional Year level filter"
            },
            {
              "key": "search",
              "value": "",
              "description": "Optional text search"
            }
          ]
        },
        "description": "GET /feePlanItem/billingRuns\n\nReturns categorized billing runs categorized by stage: actionRequired, activeBillingRuns, and upcomingRuns."
      },
      "response": []
    },
    {
      "name": "6. Get Student Billing Breakdown / Run Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/billingRuns/details?batchId={{batchId}}&billingScheduleItemId={{billingScheduleItemId}}",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "billingRuns",
            "details"
          ],
          "query": [
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Target Batch ID"
            },
            {
              "key": "billingScheduleItemId",
              "value": "{{billingScheduleItemId}}",
              "description": "Billing Schedule Item ID"
            },
            {
              "key": "studentId",
              "value": "{{studentId}}",
              "description": "Optional Student ID to filter"
            }
          ]
        },
        "description": "GET /feePlanItem/billingRuns/details?batchId={{batchId}}&billingScheduleItemId={{billingScheduleItemId}}\n\nReturns billing run details and all students in the batch, including base fee components from billingScheduleItemsModel/billingScheduleSubItemsModel, applied fee policies/scholarships (from feePolicyBatchesModel & feePolicyStudentsModel), and net payable amounts."
      },
      "response": []
    },
    {
      "name": "7. Get Single Fee Plan Item Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/single?feePlanItemId={{feePlanItemId}}&page=1&limit=10",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem",
            "single"
          ],
          "query": [
            {
              "key": "feePlanItemId",
              "value": "{{feePlanItemId}}",
              "description": "Required Fee Plan Item ID"
            },
            {
              "key": "page",
              "value": "1",
              "description": "Page number for students list"
            },
            {
              "key": "limit",
              "value": "10",
              "description": "Page size"
            }
          ]
        },
        "description": "GET /feePlanItem/single?feePlanItemId=&page=&limit=\n\nReturns single fee plan item with child sub-items, catalog names, pagination, and list of students with their invoice status."
      },
      "response": []
    },
    {
      "name": "8. Create Fee Plan Item (with Sub-Items)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.data && jsonData.data.feePlanItemId) {",
              "    pm.collectionVariables.set('feePlanItemId', jsonData.data.feePlanItemId);",
              "    if (jsonData.data.feePlanSubItems && jsonData.data.feePlanSubItems.length > 0) {",
              "        pm.collectionVariables.set('feePlanSubitemId', jsonData.data.feePlanSubItems[0].feePlanSubitemId);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"batchId\": {{batchId}},\n  \"year\": {{year}},\n  \"name\": \"Admission / Semester 1 Fee\",\n  \"createDate\": \"2026-08-01\",\n  \"feePlanSubItems\": [\n    {\n      \"feeTypeCatalogId\": {{feeTypeCatalogId}},\n      \"amount\": \"50000.00\",\n      \"isMainSubItem\": true\n    },\n    {\n      \"feeTypeCatalogId\": 2,\n      \"amount\": \"15000.00\",\n      \"isMainSubItem\": false\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseurl}}/feePlanItem",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "feePlanItem"
          ]
        },
        "description": "POST /feePlanItem\n\nCreates a new planned fee receipt item for a batch and year, along with its component sub-items in an atomic transaction."
      },
      "response": []
    },
    {
