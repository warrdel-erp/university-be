{
  "info": {
    "_postman_id": "fee-plan-item-batch-billing-v2",
    "name": "univ-v2-fee-plan-item",
    "description": "Fee Plan Item & Student Fee Invoice Billing APIs.\n\nEndpoints:\n1) GET /studentFeeInvoice/batches — Billing batches overview grouped by course and session\n2) GET /feePlanItem/batches/billing — Detailed batch fee receipts billing breakdown by batchId & year\n3) GET /feePlanItem/single — Single fee plan item details with connected batch students & current term status\n4) GET /studentFeeInvoice/all — All student fee invoices list filtered by feePlanItemId, status & optional pagination\n5) POST /studentFeeInvoice — Generate fee invoice(s) for a single student, array of student IDs, or entire batch",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseurl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..qe-ENzjK2YVd7Rp4Mg1RSuo7ylbykmzDiAknyzySPwA"
    },
    {
      "key": "academicYearId",
      "value": "59"
    },
    {
      "key": "courseId",
      "value": "34"
    },
    {
      "key": "sessionId",
      "value": "6"
    },
    {
      "key": "batchId",
      "value": "1"
    },
    {
      "key": "year",
      "value": "1"
    },
    {
      "key": "feePlanItemId",
      "value": "1"
    },
    {
      "key": "studentId",
      "value": "1"
    },
    {
      "key": "page",
      "value": "1"
    },
    {
      "key": "limit",
      "value": "10"
    },
    {
      "key": "search",
      "value": ""
    },
    {
      "key": "status",
      "value": "all"
    }
  ],
  "item": [
    {
      "name": "1. Get Billing Batches Overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/studentFeeInvoice/batches?academicYearId={{academicYearId}}&courseId={{courseId}}&sessionId={{sessionId}}&search={{search}}&status={{status}}",
          "host": ["{{baseurl}}"],
          "path": ["studentFeeInvoice", "batches"],
          "query": [
            {
              "key": "academicYearId",
              "value": "{{academicYearId}}",
              "description": "Optional Integer — Academic Year filter",
              "disabled": true
            },
            {
              "key": "courseId",
              "value": "{{courseId}}",
              "description": "Optional Integer — Course / Programme filter",
              "disabled": true
            },
            {
              "key": "sessionId",
              "value": "{{sessionId}}",
              "description": "Optional Integer — Session filter",
              "disabled": true
            },
            {
              "key": "search",
              "value": "{{search}}",
              "description": "Optional String — Course name / code / session / batch search",
              "disabled": true
            },
            {
              "key": "status",
              "value": "{{status}}",
              "description": "Optional Enum: Ready to Raise | Upcoming | Fully Billed | Not Configured",
              "disabled": true
            }
          ]
        },
        "description": "GET /studentFeeInvoice/batches\n\nReturns billing batches overview grouped by course and session with student count, current year study status, next planned invoice, and fee receipts summary."
      }
    },
    {
      "name": "2. Get Batch Billing Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/batches/billing?batchId={{batchId}}&year={{year}}",
          "host": ["{{baseurl}}"],
          "path": ["feePlanItem", "batches", "billing"],
          "query": [
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Required Integer — Batch ID"
            },
            {
              "key": "year",
              "value": "{{year}}",
              "description": "Required Integer — Fee plan year (1...courseDuration)"
            }
          ]
        },
        "description": "GET /feePlanItem/batches/billing?batchId=&year=\n\nReturns detailed fee receipts breakdown and student invoice status for a batch and study year."
      }
    },
    {
      "name": "3. Get Single Fee Plan Item Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/feePlanItem/single?feePlanItemId={{feePlanItemId}}&page={{page}}&limit={{limit}}",
          "host": ["{{baseurl}}"],
          "path": ["feePlanItem", "single"],
          "query": [
            {
              "key": "feePlanItemId",
              "value": "{{feePlanItemId}}",
              "description": "Required Integer — Fee Plan Item ID"
            },
            {
              "key": "page",
              "value": "{{page}}",
              "description": "Optional Integer — Page number",
              "disabled": true
            },
            {
              "key": "limit",
              "value": "{{limit}}",
              "description": "Optional Integer — Page size limit",
              "disabled": true
            }
          ]
        },
        "description": "GET /feePlanItem/single?feePlanItemId=&page=&limit=\n\nReturns basic details for a single fee plan item along with connected batch students, currentTerm, currentTermName, and optional pagination."
      }
    },
    {
      "name": "4. Generate Student Fee Invoice (Single / Bulk / Batch)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"feePlanItemId\": {{feePlanItemId}},\n  \"batchId\": {{batchId}}\n}"
        },
        "url": {
          "raw": "{{baseurl}}/studentFeeInvoice",
          "host": ["{{baseurl}}"],
          "path": ["studentFeeInvoice"]
        },
        "description": "POST /studentFeeInvoice\n\nGenerates student fee invoices in status: generated and paymentStatus: unpaid.\n\nBody Examples:\n1) Batch-level Bulk: { \"feePlanItemId\": 1, \"batchId\": 12 }\n2) Student IDs Bulk: { \"feePlanItemId\": 1, \"studentIds\": [101, 102] }\n3) Single Student: { \"feePlanItemId\": 1, \"studentId\": 101 }"
      }
    },
    {
      "name": "4. Get All Student Fee Invoices",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/studentFeeInvoice/all?feePlanItemId={{feePlanItemId}}&status={{status}}&page={{page}}&limit={{limit}}",
          "host": ["{{baseurl}}"],
          "path": ["studentFeeInvoice", "all"],
          "query": [
            {
              "key": "feePlanItemId",
              "value": "{{feePlanItemId}}",
              "description": "Optional Integer — Filter invoices by Fee Plan Item ID"
            },
            {
              "key": "status",
              "value": "{{status}}",
              "description": "Optional Enum: all | pending | completed"
            },
            {
              "key": "page",
              "value": "{{page}}",
              "description": "Optional Integer — Page number",
              "disabled": true
            },
            {
              "key": "limit",
              "value": "{{limit}}",
              "description": "Optional Integer — Page size limit",
              "disabled": true
            }
          ]
        },
        "description": "GET /studentFeeInvoice/all?feePlanItemId=&status=&page=&limit=\n\nReturns student fee invoices filtered by feePlanItemId and status with central header summary metrics (studentCount, invoicesCount, pendingInvoicesCount) and optional pagination."
      }
    }
  ]
}
