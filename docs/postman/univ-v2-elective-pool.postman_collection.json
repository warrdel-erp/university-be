      "name": "1. Elective Pool",
      "description": "CRUD operations for managing elective pools across scopes (Image 1)",
      "item": [
        {
          "name": "1. Create Elective Pool (Programme Scope - Default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"electivePoolId\", String(jsonData.data.id));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Architecture Professional Electives\",\n  \"code\": \"ARCH-PROF\",\n  \"description\": \"Advanced discipline-specific electives for architecture and allied areas.\",\n  \"scope\": \"programme\",\n  \"courseId\": 34,\n  \"instituteId\": 12\n}"
            },
            "url": {
              "raw": "{{baseurl}}/electivePool/create",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "electivePool",
                "create"
              ]
            }
          }
        },
