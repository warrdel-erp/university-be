              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function requireVar(name) {",
                  "  const value = pm.collectionVariables.get(name);",
                  "  if (!value) throw new Error(name + ' is not set. Run department create first.');",
                  "  return Number(value);",
                  "}",
                  "pm.request.body.update(JSON.stringify({",
                  "  departmentId: requireVar('departmentId'),",
                  "  positionName: 'Chancellor',",
