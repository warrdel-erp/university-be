    {
      "name": "notice",
      "description": "Notices under /notice.\n\n**Auth:** Bearer {{token}}.\n\n**Tenant scope (utility/scoped.js):** Active login context from PUT /user/saveUserDefaults + optional x-institute-id header. Query/body acedmicYearId, instituteId, universityId are optional (FE compat) and ignored in business logic.\n\n**GET /studentNotice** (Plan B): institute + university from login; no academic year filter. Role-based message_to filter.\n\n**GET /employee**: full scoped (institute + university + academic year).",
      "item": [
        {
          "name": "create",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Exam schedule\",\n  \"notice\": \"Mid-term exams begin next week.\",\n  \"noticeDate\": \"2026-06-27\",\n  \"publishDate\": \"2026-06-27\",\n  \"messageTo\": [\n    \"ADMIN\",\n    \"TEACHER\",\n    \"STUDENT\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/notice",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "notice"
              ]
            },
            "description": "**POST /notice**\n\nRequired: title, messageTo (string or array). Optional: notice, noticeDate, publishDate. Tenant fields stripped from body and injected via scoped()."
          },
          "response": []
        },
        {
          "name": "studentNotice (teacher / student)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/notice/studentNotice?acedmicYearId={{acedmicYear_id}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "notice",
                "studentNotice"
              ],
              "query": [
                {
                  "key": "acedmicYearId",
                  "value": "{{acedmicYear_id}}",
                  "description": "Optional — ignored"
                },
                {
                  "key": "instituteId",
                  "value": "{{institute_id}}",
                  "disabled": true
                },
                {
                  "key": "universityId",
                  "value": "",
                  "disabled": true
                }
              ]
            },
            "description": "**GET /notice/studentNotice**\n\n**Scope:** institute + university (all academic years).\n\n| defaultRole | message_to match |\n|-------------|------------------|\n| TEACHER | ADMIN, TEACHER, or STUDENT |\n| Other | STUDENT or Student |\n\n**200:** flat notice array, noticeId DESC."
          },
          "response": []
        },
        {
          "name": "employee notices",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseurl}}/notice/employee?acedmicYearId={{acedmicYear_id}}",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "notice",
                "employee"
              ],
              "query": [
                {
                  "key": "acedmicYearId",
                  "value": "{{acedmicYear_id}}",
                  "description": "Optional — ignored"
                }
              ]
            },
            "description": "**GET /notice/employee**\n\n**200:** { noticeCreated, noticeAll }\n\n- noticeCreated — notices created by logged-in user (scoped institute + university + academic year)\n- noticeAll — notices where message_to contains caller defaultRole (e.g. TEACHER)"
          },
          "response": []
        },
