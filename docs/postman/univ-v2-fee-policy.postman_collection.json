                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "GET /feePolicy\n\nReturns paginated list of fee policies with attached components, courses, batches, and slabs."
          },
          "response": []
