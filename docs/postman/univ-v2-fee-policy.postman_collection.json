  "item": [
    {
      "name": "Fee Policy",
      "item": [
        {
          "name": "1. Create Fee Policy (Reduce Fee / Scholarship)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyName\": \"Merit Scholarship 2026\",\n  \"description\": \"20% discount on tuition fee for eligible courses, years and terms\",\n  \"appliesTo\": \"selected_components\",\n  \"effect\": \"reduce_fee\",\n  \"calculationType\": \"percentage\",\n  \"percentageRate\": 20,\n  \"fixedAmount\": null,\n  \"gracePeriodDays\": 0,\n  \"maxCapAmount\": 25000,\n  \"publishStatus\": \"draft\",\n  \"feeTypeCatalogIds\": [\n    1,\n    2\n  ],\n  \"courses\": [\n    {\n      \"courseId\": 36,\n      \"years\": [\n        {\n          \"year\": 1,\n          \"terms\": [1, 2]\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/feePolicy",
              "host": ["{{baseurl}}"],
              "path": ["feePolicy"]
            },
            "description": "POST /feePolicy\n\nCreates a new Fee Policy in draft (or published) state.\n\nKey features:\n- effect: reduce_fee | add_charge | refund\n- appliesTo: selected_components | all_components\n- courses: array of { courseId, years: [{ year, terms: [1, 2] }] } for scoping by course, year and term\n- calculationType: percentage | fixed_amount | per_day | percentage_of_outstanding | slab_based"
          },
          "response": []
        },
        {
          "name": "2. Create Fee Policy (Add Charge / Late Fee)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyName\": \"Late Payment Surcharge\",\n  \"description\": \"50 per day after 5 days grace period for Year 1 terms\",\n  \"appliesTo\": \"all_components\",\n  \"effect\": \"add_charge\",\n  \"calculationType\": \"per_day\",\n  \"fixedAmount\": 50,\n  \"gracePeriodDays\": 5,\n  \"maxCapAmount\": 5000,\n  \"referenceDateEvent\": \"planned_date\",\n  \"publishStatus\": \"draft\",\n  \"courses\": [\n    {\n      \"courseId\": 36,\n      \"years\": [\n        {\n          \"year\": 1,\n          \"terms\": [1, 2]\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/feePolicy",
              "host": ["{{baseurl}}"],
              "path": ["feePolicy"]
            },
            "description": "POST /feePolicy\n\nCreates a late fee / overdue charge policy calculated per day with a grace period."
          },
          "response": []
        },
        {
          "name": "3. Create Fee Policy (Refund with Slabs)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policyName\": \"Admission Cancellation Refund Policy\",\n  \"description\": \"UGC slab-based refund percentage based on days before/after course commencement\",\n  \"appliesTo\": \"all_components\",\n  \"effect\": \"refund\",\n  \"calculationType\": \"slab_based\",\n  \"publishStatus\": \"published\",\n  \"courses\": [\n    {\n      \"courseId\": 36,\n      \"years\": [\n        {\n          \"year\": 1,\n          \"terms\": [1, 2]\n        }\n      ]\n    }\n  ],\n  \"slabs\": [\n    {\n      \"relativePeriod\": \"before\",\n      \"fromUnit\": 15,\n      \"toUnit\": null,\n      \"slabValue\": 100,\n      \"orderIndex\": 1\n    },\n    {\n      \"relativePeriod\": \"before\",\n      \"fromUnit\": 0,\n      \"toUnit\": 15,\n      \"slabValue\": 90,\n      \"orderIndex\": 2\n    },\n    {\n      \"relativePeriod\": \"after\",\n      \"fromUnit\": 1,\n      \"toUnit\": 15,\n      \"slabValue\": 80,\n      \"orderIndex\": 3\n    },\n    {\n      \"relativePeriod\": \"after\",\n      \"fromUnit\": 16,\n      \"toUnit\": 30,\n      \"slabValue\": 50,\n      \"orderIndex\": 4\n    },\n    {\n      \"relativePeriod\": \"after\",\n      \"fromUnit\": 31,\n      \"toUnit\": null,\n      \"slabValue\": 0,\n      \"orderIndex\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/feePolicy",
              "host": ["{{baseurl}}"],
              "path": ["feePolicy"]
            },
            "description": "POST /feePolicy\n\nCreates a published refund policy with multi-tier slab calculations."
          },
          "response": []
        },
        {
          "name": "4. List Fee Policies",
          "request": {
            "method": "GET",
            "header": [
