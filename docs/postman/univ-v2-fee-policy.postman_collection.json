        {
          "name": "4. Create Billing Schedules (Bulk Array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "var firstItem = Array.isArray(jsonData.data) ? jsonData.data[0] : jsonData.data;",
                  "if (firstItem && firstItem.billingScheduleItemId) {",
                  "    pm.collectionVariables.set('billingScheduleItemId', firstItem.billingScheduleItemId);",
                  "    if (firstItem.subItems && firstItem.subItems.length > 0) {",
                  "        pm.collectionVariables.set('billingScheduleSubItemId', firstItem.subItems[0].billingScheduleSubItemId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"feePlanItemId\": {{feePlanItemId}},\n    \"amount\": 25000.00,\n    \"plannedDate\": \"2026-11-20\",\n    \"status\": \"pending\",\n    \"subItems\": [\n      {\n        \"feePlanSubItemId\": {{feePlanSubItemId}},\n        \"amount\": 25000.00\n      }\n    ],\n    \"paymentTerms\": [\n      {\n        \"installment\": 1\n      }\n    ]\n  },\n  {\n    \"feePlanItemId\": {{feePlanItemId}},\n    \"amount\": 25000.00,\n    \"plannedDate\": \"2026-12-20\",\n    \"status\": \"pending\",\n    \"subItems\": [\n      {\n        \"feePlanSubItemId\": {{feePlanSubItemId}},\n        \"amount\": 25000.00\n      }\n    ],\n    \"paymentTerms\": [\n      {\n        \"installment\": 2\n      }\n    ]\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/billingSchedule",
              "host": ["{{baseurl}}"],
              "path": ["billingSchedule"]
            },
            "description": "POST /billingSchedule\n\nCreates multiple billing schedule items (e.g. 2 installments) along with sub-items and payment terms in an atomic transaction."
          },
          "response": []
        },
