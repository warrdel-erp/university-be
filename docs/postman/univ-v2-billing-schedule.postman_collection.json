    {
      "name": "1. Get Batches (Grouped Course-wise)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseurl}}/billingSchedule/batches?batchId={{batchId}}&courseId={{courseId}}",
          "host": [
            "{{baseurl}}"
          ],
          "path": [
            "billingSchedule",
            "batches"
          ],
          "query": [
            {
              "key": "batchId",
              "value": "{{batchId}}",
              "description": "Optional Batch ID filter"
            },
            {
              "key": "courseId",
              "value": "{{courseId}}",
              "description": "Optional Course ID filter"
            }
          ]
        },
        "description": "GET /billingSchedule/batches\n\nReturns all batches grouped course-wise with session and fee plan overview."
      },
      "response": []
    },
